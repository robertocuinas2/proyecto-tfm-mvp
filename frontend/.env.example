# Docker with nginx proxy, same origin.
# Leave empty: the browser uses the same URL as the frontend.
NEXT_PUBLIC_API_URL=

# Local development without Docker.
# Uncomment when the backend runs directly on port 8000.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Internal operational assistant. Set to false to remove it from the UI.
NEXT_PUBLIC_ENABLE_ASSISTANT=false
